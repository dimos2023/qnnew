{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/models/maextro-s800", "destination": "/models/maextro-s800.html" },
    { "source": "/models/yangwang-u9", "destination": "/models/yangwang-u9.html" },
    { "source": "/models/yangwang-u8l", "destination": "/models/yangwang-u8l.html" },
    { "source": "/concierge", "destination": "/concierge.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/build", "destination": "/configure.html" },
    { "source": "/join", "destination": "/join.html" },
    { "source": "/test-drive", "destination": "/test-drive.html" },
    { "source": "/ownership", "destination": "/ownership.html" },
    { "source": "/compare", "destination": "/compare.html" },
    { "source": "/commission", "destination": "/commission.html" },
    { "source": "/journal", "destination": "/journal.html" },
    { "source": "/journal/the-quiet-revolution", "destination": "/journal-article.html" },
    { "source": "/owners", "destination": "/owners.html" },
    { "source": "/experience", "destination": "/experience.html" },
    { "source": "/usage-policy", "destination": "/usage-policy.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()" }
      ]
    },
    {
      "source": "/assets/video/(.*)",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ]
    },
    {
      "source": "/assets/(.*)\\.(png|jpg|jpeg|webp|avif|svg|ico|woff|woff2)",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ]
    },
    {
      "source": "/assets/(.*)\\.(css|js)",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ]
    }
  ]
}
